    "TimeoutSeconds": 120,
    "MaxOutputChars": 200000,
    "HeartbeatIntervalSeconds": 2
  },
  "S3": {
    "Endpoint": "http://localhost:9000",
    "Bucket": "algosim-artifacts",
    "AccessKey": "minio",
    "SecretKey": "minio123",
    "UsePathStyle": true
  }
}
